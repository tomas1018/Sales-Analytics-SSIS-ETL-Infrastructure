          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{21E8416C-DC12-4285-A679-0FA130FAB963}"
              SQLTask:SqlStatementSource="IF NOT EXISTS (SELECT * FROM sys.databases WHERE name = 'bd_inter_sales')&#xA;BEGIN&#xA;    CREATE DATABASE [bd_inter_sales];&#xA;END;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Preparar base de datos intermedia\Crear tabla y store procedure tiempo"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:DelayValidation="True"
          DTS:Description="Tarea Ejecutar SQL"
          DTS:DTSID="{69c8b3e8-5cab-4f50-8c19-54c997513895}"
