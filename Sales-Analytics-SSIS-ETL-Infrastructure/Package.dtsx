                  description="OLE DB Source"
                  name="FACT_VENTAS"
                  usesDispositions="true"
                  version="7">
                  <properties>
                    <property
                      dataType="System.Int32"
                      description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                      name="CommandTimeout">0</property>
                    <property
                      dataType="System.String"
                      description="Specifies the name of the database object used to open a rowset."
                      name="OpenRowset">[dbo].[INT_FACT_SALES]</property>
                    <property
                      dataType="System.String"
                      description="Specifies the variable that contains the name of the database object used to open a rowset."
                      name="OpenRowsetVariable"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT fi.*, dcus.key_customer, dem.key_empleados, dprod.key_producto, dti.key_tiempo, dre.key_rango_etario, dre.rango_etario
FROM [INTERMEDIA].[dbo].[FACT_INTERMEDIA] AS fi
LEFT JOIN [DATAWAREHOUSE].[dbo].[Dim_rangos_etarios] AS dre ON fi.edad_cliente &gt;= dre.edad_minima AND fi.edad_cliente &lt;= dre.edad_maxima
LEFT JOIN [DATAWAREHOUSE].[dbo].[Dim_customer] AS dcus ON dcus.CUSTOMER_ID = fi.CUSTOMER_ID
LEFT JOIN [DATAWAREHOUSE].[dbo].[Dim_empleados] AS dem ON dem.EMPLOYEE_ID = fi.EMPLOYEE_ID
LEFT JOIN [DATAWAREHOUSE].[dbo].[Dim_producto] AS dprod ON dprod.ID_Prod = fi.PRODUCT_ID
LEFT JOIN [DATAWAREHOUSE].[dbo].[Dim_tiempo] AS dti ON CAST(dti.Fecha AS date) = CAST(fi.DATE AS date);</property>
                    <property
                      dataType="System.String"
                      description="The variable that contains the SQL command to be executed."
                      name="SqlCommandVariable"></property>
