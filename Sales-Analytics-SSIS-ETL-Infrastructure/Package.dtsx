          DTS:LogicalAnd="True"
          DTS:ObjectName="Restricción"
          DTS:To="Package\Preparar base de datos intermedia\TRUNCATE tablas intermedia" />
        <DTS:PrecedenceConstraint
          DTS:refId="Package\Preparar base de datos intermedia.PrecedenceConstraints[Restricción 1]"
          DTS:CreationName=""
          DTS:DTSID="{B5A8D8E0-6AB2-45F8-BB83-C157E14DB1E4}"
          DTS:From="Package\Preparar base de datos intermedia\Crear tablas"
          DTS:LogicalAnd="True"
          DTS:ObjectName="Restricción 1"
          DTS:To="Package\Preparar base de datos intermedia\Crear tabla y store procedure tiempo" />
        <DTS:PrecedenceConstraint
          DTS:refId="Package\Preparar base de datos intermedia.PrecedenceConstraints[Restricción 3]"
          DTS:CreationName=""
          DTS:DTSID="{136A9192-7D47-49F4-B223-8298F54D7896}"
