                  description="Creates new column values by applying expressions to transformation input columns. Create new columns or overwrite existing ones. For example, concatenate the values from the 'first name' and 'last name' column to make a 'full name' column."
                  name="Agregar columnas de is_can, packaging_type y liters"
                  usesDispositions="true">
                  <inputs>
                    <input
                      refId="Package\INTERMEDIA\PRODUCTOS\Agregar columnas de is_can, packaging_type y liters.Inputs[Derived Column Input]"
                      description="Input to the Derived Column Transformation"
                      name="Derived Column Input">
                      <inputColumns>
                        <inputColumn
                          refId="Package\INTERMEDIA\PRODUCTOS\Agregar columnas de is_can, packaging_type y liters.Inputs[Derived Column Input].Columns[Volume]"
                          cachedDataType="numeric"
                          cachedName="Volume"
