    <DTS:Executable
      DTS:refId="Package\Preparar datawarehouse"
      DTS:CreationName="STOCK:SEQUENCE"
      DTS:Description="Contenedor de secuencias"
      DTS:DTSID="{8E332274-6D33-4256-AB34-EEF79125A02D}"
      DTS:ExecutableType="STOCK:SEQUENCE"
      DTS:LocaleID="-1"
      DTS:ObjectName="Preparar datawarehouse">
      <DTS:Variables />
      <DTS:Executables>
        <DTS:Executable
          DTS:refId="Package\Preparar datawarehouse\Crear base de datos"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Si no existe, crea la base de datos, en caso contrario sigue de largo"
          DTS:DTSID="{853f1fd5-d04c-4ae6-9f02-f7da685f4d8c}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Crear base de datos"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{43E8FA75-9B2D-4C20-83CA-7008822B6AE8}"
              SQLTask:SqlStatementSource="IF NOT EXISTS (SELECT * FROM sys.databases WHERE name = 'bd_datawarehouse_sales')&#xA;BEGIN&#xA;    CREATE DATABASE [bd_datawarehouse_sales];&#xA;END;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Preparar datawarehouse\Crear store procedure tiempo"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:DelayValidation="True"
          DTS:Description="Tarea Ejecutar SQL"
          DTS:DTSID="{82458cac-a377-4230-b65a-fe2c36726e74}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Crear store procedure tiempo"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{0471B802-F7D6-488B-93BC-AA645151E61A}"
              SQLTask:BypassPrepare="False"
              SQLTask:SqlStatementSource="GO&#xA;&#xA;/* ELIMINAR SI EXISTE */&#xA;IF EXISTS (SELECT * FROM sys.objects WHERE object_id = OBJECT_ID(N'[dbo].[SP_LOAD_DIM_TIME_DWH]') AND type in (N'P'))&#xA;BEGIN&#xA;    DROP PROCEDURE [dbo].[SP_LOAD_DIM_TIME_DWH];&#xA;END;&#xA;GO&#xA;&#xA;CREATE PROCEDURE [dbo].[SP_LOAD_DIM_TIME_DWH]&#xA;AS&#xA;BEGIN&#xA;    SET NOCOUNT ON;&#xA;&#xA;    -- Limpieza de la tabla de destino en el DWH&#xA;    TRUNCATE TABLE [dbo].[DIM_TIME];&#xA;&#xA;    -- Traspaso directo desde la Intermedia&#xA;    INSERT INTO [dbo].[DIM_TIME] (&#xA;        [KEY_TIME], [FULL_DATE], [DAY], [MONTH], [MONTH_NAME], [YEAR], &#xA;        [QUARTER], [SEMESTER], [WEEKDAY], [WEEKDAY_NAME], [WEEK_NUMBER], [DAY_OF_YEAR]&#xA;    )&#xA;    SELECT &#xA;        [KEY_TIME], [FULL_DATE], [DAY], [MONTH], [MONTH_NAME], [YEAR], &#xA;        [QUARTER], [SEMESTER], [WEEKDAY], [WEEKDAY_NAME], [WEEK_NUMBER], [DAY_OF_YEAR]&#xA;    FROM [bd_inter_sales].[dbo].[INT_TIME]; -- Tomamos la fuente ya estable&#xA;END;&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Preparar datawarehouse\Crear tablas"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:DelayValidation="True"
          DTS:Description="Tarea Ejecutar SQL"
          DTS:DTSID="{641b3359-4d51-4e50-887e-ee1169ca8d33}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Crear tablas"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{0471B802-F7D6-488B-93BC-AA645151E61A}"
              SQLTask:BypassPrepare="False"
              SQLTask:SqlStatementSource="/*  DIMENSIÓN CUSTOMERS */&#xA;IF NOT EXISTS (SELECT * FROM sys.objects WHERE object_id = OBJECT_ID(N'[dbo].[DIM_CUSTOMERS]') AND type in (N'U'))&#xA;BEGIN&#xA;    CREATE TABLE [dbo].[DIM_CUSTOMERS](&#xA;        [CUSTOMER_ID] [int] NOT NULL, &#xA;        [FULL_NAME] [nvarchar](255) NULL,&#xA;        [BIRTH_DATE] [datetime] NULL,&#xA;        [CUSTOMER_AGE] [int] NULL,&#xA;        [CITY] [nvarchar](255) NULL,&#xA;        [STATE] [nvarchar](255) NULL,&#xA;        [ZIPCODE] [nvarchar](255) NULL,&#xA;        [CUSTOMER_TYPE] [nvarchar](9) NULL,&#xA;        CONSTRAINT [PK_DIM_CUSTOMER] PRIMARY KEY CLUSTERED ([CUSTOMER_ID] ASC)&#xA;    )&#xA;END;&#xA;&#xA;/*  DIMENSIÓN EMPLOYEES */&#xA;IF NOT EXISTS (SELECT * FROM sys.objects WHERE object_id = OBJECT_ID(N'[dbo].[DIM_EMPLOYEES]') AND type in (N'U'))&#xA;BEGIN&#xA;    CREATE TABLE [dbo].[DIM_EMPLOYEES](&#xA;        [EMPLOYEE_ID] [int] NOT NULL,&#xA;        [FULL_NAME] [nvarchar](255) NULL,&#xA;        [CATEGORY] [nvarchar](255) NULL,&#xA;        [GENDER] [nvarchar](255) NULL,&#xA;        [EMPLOYMENT_DATE] [datetime] NULL,&#xA;        [BIRTH_DATE] [datetime] NULL,&#xA;        CONSTRAINT [PK_DIM_EMPLOYEE] PRIMARY KEY CLUSTERED ([EMPLOYEE_ID] ASC)&#xA;    )&#xA;END;&#xA;&#xA;/*  DIMENSIÓN PRODUCTS */&#xA;IF NOT EXISTS (SELECT * FROM sys.objects WHERE object_id = OBJECT_ID(N'[dbo].[DIM_PRODUCTS]') AND type in (N'U'))&#xA;BEGIN&#xA;    CREATE TABLE [dbo].[DIM_PRODUCTS](&#xA;        [PRODUCT_ID] [int] NOT NULL,&#xA;        [PRODUCT_NAME] [nvarchar](255) NULL,&#xA;        [LITERS] [decimal](18, 2) NULL, &#xA;        [PACKAGING_TYPE] [nvarchar](50) NULL, &#xA;        [IS_CAN] [int] NULL,&#xA;        CONSTRAINT [PK_DIM_PRODUCT] PRIMARY KEY CLUSTERED ([PRODUCT_ID] ASC)&#xA;    )&#xA;END;&#xA;&#xA;/*  DIMENSIÓN REGIONS */&#xA;IF NOT EXISTS (SELECT * FROM sys.objects WHERE object_id = OBJECT_ID(N'[dbo].[DIM_REGIONS]') AND type in (N'U'))&#xA;BEGIN&#xA;    CREATE TABLE [dbo].[DIM_REGIONS](&#xA;        [REGION_ID] [int] IDENTITY(1,1) NOT NULL,&#xA;        [REGION_NAME] [nvarchar](255) NULL,&#xA;        [AREA] [nvarchar](255) NULL,&#xA;        [CITY] [nvarchar](255) NULL,&#xA;        [ZIPCODE] [nvarchar](255) NULL,&#xA;        CONSTRAINT [PK_DIM_REGION] PRIMARY KEY CLUSTERED ([REGION_ID] ASC)&#xA;    )&#xA;END;&#xA;&#xA;/*  DIMENSIÓN AGE RANGE */&#xA;IF NOT EXISTS (SELECT * FROM sys.objects WHERE object_id = OBJECT_ID(N'[dbo].[DIM_AGE_RANGE]') AND type in (N'U'))&#xA;BEGIN&#xA;    CREATE TABLE [dbo].[DIM_AGE_RANGE](&#xA;        [AgeRangeID] [int] IDENTITY(1,1) NOT NULL,&#xA;        [AGE_RANGE_NAME] [nvarchar](50) NULL,&#xA;        [MinAge] [int] NULL, &#xA;        [MaxAge] [int] NULL, &#xA;        CONSTRAINT [PK_DIM_AGE_RANGE] PRIMARY KEY CLUSTERED ([AgeRangeID] ASC)&#xA;    )&#xA;END;&#xA;&#xA;/*  TABLA DE HECHOS: FACT_SALES */&#xA;IF NOT EXISTS (SELECT * FROM sys.objects WHERE object_id = OBJECT_ID(N'[dbo].[FACT_SALES]') AND type in (N'U'))&#xA;BEGIN&#xA;    CREATE TABLE [dbo].[FACT_SALES](&#xA;        [Fact_SalesKey] [bigint] IDENTITY(1,1) NOT NULL, -- BIGINT por el volumen de 1.6M&#xA;        [BillingID] [int] NOT NULL,&#xA;        [CustomerID] [int] NOT NULL,&#xA;        [EmployeeID] [int] NOT NULL,&#xA;        [ProductID] [int] NOT NULL,&#xA;        [RegionID]  [int] NOT NULL,&#xA;        [TimeKey] [int] NOT NULL,&#xA;        [TransactionTimestamp] [datetime] NULL,&#xA;        [Month] [nvarchar](50) NULL,&#xA;        [Year] [int] NULL,&#xA;        [IsHoliday] [nvarchar](3) NULL,&#xA;        [HolidayDescription] [nvarchar](100) NULL,&#xA;        [ValidatedRegion] [nvarchar](100) NULL,&#xA;        [CustomerZipCode] [nvarchar](255) NOT NULL,&#xA;        [AgeRangeID] [int] NOT NULL,&#xA;        [PackagingType] [nvarchar](50) NULL,&#xA;        [Quantity] [decimal](18, 1) NULL,&#xA;        [LitersSold] [decimal](18, 1) NULL,&#xA;        [ListUnitPrice] [decimal](18, 2) NULL,&#xA;        [DiscountPercentage] [decimal](18, 2) NULL,&#xA;        [GrossLineTotal] [decimal](18, 2) NULL,&#xA;        [NetLineTotal] [decimal](18, 2) NULL,&#xA;        [GlobalCartTotal] [decimal](18, 2) NULL,&#xA;        CONSTRAINT [PK_FACT_SALES] PRIMARY KEY CLUSTERED ([Fact_SalesKey] ASC)&#xA;    ) ON [PRIMARY];&#xA;END;&#xA;&#xA;IF NOT EXISTS (SELECT * FROM sys.objects WHERE object_id = OBJECT_ID(N'[dbo].[DIM_TIME]') AND type in (N'U'))&#xA;BEGIN&#xA;    CREATE TABLE [dbo].[DIM_TIME](&#xA;        [KEY_TIME] [int] NOT NULL,&#xA;        [FULL_DATE] [date] NULL,&#xA;        [DAY] [int] NULL,&#xA;        [MONTH] [int] NULL,&#xA;        [MONTH_NAME] [nvarchar](50) NULL,&#xA;        [YEAR] [int] NULL,&#xA;        [QUARTER] [int] NULL,&#xA;        [SEMESTER] [int] NULL,&#xA;        [WEEKDAY] [int] NULL,&#xA;        [WEEKDAY_NAME] [nvarchar](50) NULL,&#xA;        [WEEK_NUMBER] [int] NULL,&#xA;        [DAY_OF_YEAR] [int] NULL,&#xA;        CONSTRAINT [PK_DIM_TIME] PRIMARY KEY CLUSTERED ([KEY_TIME] ASC)&#xA;    )&#xA;END;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Preparar datawarehouse\Eliminar todos los INDEX"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Tarea Ejecutar SQL"
          DTS:DTSID="{A04E9DB4-7E81-40F6-B06A-9C8506512DC2}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Eliminar todos los INDEX"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{0471B802-F7D6-488B-93BC-AA645151E61A}"
              SQLTask:SqlStatementSource="SET NOCOUNT ON;&#xA;&#xA;DECLARE @sql_drop_fks NVARCHAR(MAX) = N'';&#xA;DECLARE @sql_drop_indexes NVARCHAR(MAX) = N'';&#xA;&#xA;-- 1. GENERAR CAÍDA DE FOREIGN KEYS&#xA;SELECT @sql_drop_fks += 'ALTER TABLE ' + QUOTENAME(cs.name) + '.' + QUOTENAME(st.name) + &#xA;                        ' DROP CONSTRAINT ' + QUOTENAME(fk.name) + ';' + CHAR(13)&#xA;FROM sys.foreign_keys AS fk&#xA;INNER JOIN sys.tables AS st ON fk.parent_object_id = st.object_id&#xA;INNER JOIN sys.schemas AS cs ON st.schema_id = cs.schema_id&#xA;WHERE cs.name = 'dbo';&#xA;&#xA;-- 2. GENERAR CAÍDA DE ÍNDICES (Excepto Primary Keys)&#xA;SELECT @sql_drop_indexes += 'DROP INDEX ' + QUOTENAME(ix.name) + ' ON ' + QUOTENAME(cs.name) + '.' + QUOTENAME(st.name) + ';' + CHAR(13)&#xA;FROM sys.indexes AS ix&#xA;INNER JOIN sys.tables AS st ON ix.object_id = st.object_id&#xA;INNER JOIN sys.schemas AS cs ON st.schema_id = cs.schema_id&#xA;WHERE ix.is_primary_key = 0    &#xA;  AND ix.type = 2              &#xA;  AND st.is_ms_shipped = 0 &#xA;  AND cs.name = 'dbo';&#xA;&#xA;-- 3. EJECUCIÓN&#xA;IF @sql_drop_fks &lt;&gt; N''&#xA;BEGIN&#xA;    EXEC sp_executesql @sql_drop_fks;&#xA;END&#xA;&#xA;IF @sql_drop_indexes &lt;&gt; N''&#xA;BEGIN&#xA;    EXEC sp_executesql @sql_drop_indexes;&#xA;END&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Preparar datawarehouse\Truncate tablas final"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Tarea Ejecutar SQL"
          DTS:DTSID="{63479205-60f3-4484-b3bd-3fb10ac16d90}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Truncate tablas final"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{0471B802-F7D6-488B-93BC-AA645151E61A}"
              SQLTask:SqlStatementSource="/* LIMPIEZA DE DIMENSIONES Y FACT TABLE CON VERIFICACIÓN */&#xA;&#xA;IF OBJECT_ID('[dbo].[DIM_CUSTOMERS]', 'U') IS NOT NULL&#xA;    TRUNCATE TABLE [dbo].[DIM_CUSTOMERS];&#xA;&#xA;IF OBJECT_ID('[dbo].[DIM_EMPLOYEES]', 'U') IS NOT NULL&#xA;    TRUNCATE TABLE [dbo].[DIM_EMPLOYEES];&#xA;&#xA;IF OBJECT_ID('[dbo].[DIM_PRODUCTS]', 'U') IS NOT NULL&#xA;    TRUNCATE TABLE [dbo].[DIM_PRODUCTS];&#xA;&#xA;IF OBJECT_ID('[dbo].[DIM_REGIONS]', 'U') IS NOT NULL&#xA;    TRUNCATE TABLE [dbo].[DIM_REGIONS];&#xA;&#xA;IF OBJECT_ID('[dbo].[DIM_AGE_RANGE]', 'U') IS NOT NULL&#xA;    TRUNCATE TABLE [dbo].[DIM_AGE_RANGE];&#xA;&#xA;IF OBJECT_ID('[dbo].[FACT_SALES]', 'U') IS NOT NULL&#xA;    TRUNCATE TABLE [dbo].[FACT_SALES];&#xA;&#xA;/* CARGA AUTOMÁTICA DE LA DIMENSIÓN TIEMPO */&#xA;IF OBJECT_ID('[dbo].[SP_LOAD_DIM_TIME_DWH]', 'P') IS NOT NULL&#xA;    EXEC [dbo].[SP_LOAD_DIM_TIME_DWH];" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>
