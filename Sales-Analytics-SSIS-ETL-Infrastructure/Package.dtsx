          DTS:LocaleID="-1"
          DTS:ObjectName="Crear tabla y store procedure tiempo"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{43E8FA75-9B2D-4C20-83CA-7008822B6AE8}"
              SQLTask:BypassPrepare="False"
              SQLTask:SqlStatementSource="/* 1. ESTRUCTURA DE LA TABLA DE TIEMPO */&#xA;IF NOT EXISTS (SELECT * FROM sys.objects WHERE object_id = OBJECT_ID(N'[dbo].[INT_TIME]') AND type in (N'U'))&#xA;BEGIN&#xA;    CREATE TABLE [dbo].[INT_TIME](&#xA;        [KEY_TIME] [int] NOT NULL,&#xA;        [FULL_DATE] [date] NULL,&#xA;        [DAY] [int] NULL,&#xA;        [MONTH] [int] NULL,&#xA;        [MONTH_NAME] [nvarchar](50) NULL,&#xA;        [YEAR] [int] NULL,&#xA;        [QUARTER] [int] NULL,&#xA;        [SEMESTER] [int] NULL,&#xA;        [WEEKDAY] [int] NULL,&#xA;        [WEEKDAY_NAME] [nvarchar](50) NULL,&#xA;        [WEEK_NUMBER] [int] NULL,&#xA;        [DAY_OF_YEAR] [int] NULL,&#xA;        CONSTRAINT [PK_INT_TIME] PRIMARY KEY CLUSTERED ([KEY_TIME] ASC)&#xA;    )&#xA;END;&#xA;&#xA;/* 2. ELIMINAR EL SP SI YA EXISTE (Para poder actualizarlo) */&#xA;IF EXISTS (SELECT * FROM sys.objects WHERE object_id = OBJECT_ID(N'[dbo].[SP_LOAD_INT_TIME]') AND type in (N'P'))&#xA;BEGIN&#xA;    DROP PROCEDURE [dbo].[SP_LOAD_INT_TIME];&#xA;END;&#xA;GO&#xA;&#xA;/* 3. CREACIÓN DEL STORED PROCEDURE CON TU LÓGICA ORIGINAL */&#xA;CREATE PROCEDURE [dbo].[SP_LOAD_INT_TIME]&#xA;AS&#xA;BEGIN&#xA;    DECLARE @StartDate DATE;&#xA;    DECLARE @EndDate DATE;&#xA;&#xA;    -- Obtenemos los rangos dinámicos desde Staging&#xA;    SELECT @StartDate = MIN(date) FROM [bd_staging_sales].[dbo].[STG_SQL_BILLING];&#xA;    SELECT @EndDate = MAX(date) FROM [bd_staging_sales].[dbo].[STG_MYSQL_BILLING];&#xA;&#xA;    -- Limpieza interna antes de cargar&#xA;    TRUNCATE TABLE [dbo].[INT_TIME];&#xA;&#xA;    WITH Fechas(Fecha) AS (&#xA;        SELECT @StartDate&#xA;        UNION ALL&#xA;        SELECT DATEADD(d, 1, Fecha)&#xA;        FROM Fechas&#xA;        WHERE Fecha &lt; @EndDate&#xA;    )&#xA;    INSERT INTO [dbo].[INT_TIME] (&#xA;        [KEY_TIME], [FULL_DATE], [DAY], [MONTH], [MONTH_NAME], [YEAR], &#xA;        [QUARTER], [SEMESTER], [WEEKDAY], [WEEKDAY_NAME], [WEEK_NUMBER], [DAY_OF_YEAR]&#xA;    )&#xA;    SELECT &#xA;        (YEAR(Fecha) * 10000) + (MONTH(Fecha) * 100) + DAY(Fecha) AS [KEY_TIME],&#xA;        Fecha AS [FULL_DATE],&#xA;        DAY(Fecha) AS [DAY], &#xA;        MONTH(Fecha) AS [MONTH], &#xA;        DATENAME(MONTH, Fecha) AS [MONTH_NAME], &#xA;        YEAR(Fecha) AS [YEAR], &#xA;        DATEPART(QUARTER, Fecha) AS [QUARTER], &#xA;        (DATEPART(QUARTER, Fecha) + 1) / 2 AS [SEMESTER], &#xA;        DATEPART(WEEKDAY, Fecha) AS [WEEKDAY], &#xA;        DATENAME(WEEKDAY, Fecha) AS [WEEKDAY_NAME], &#xA;        DATEPART(WEEK, Fecha) AS [WEEK_NUMBER], &#xA;        DATEPART(DAYOFYEAR, Fecha) AS [DAY_OF_YEAR]&#xA;    FROM Fechas&#xA;    OPTION (MAXRECURSION 0);&#xA;END;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Preparar base de datos intermedia\Crear tablas"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:DelayValidation="True"
          DTS:Description="Tarea Ejecutar SQL"
          DTS:DTSID="{20f11c7a-7613-4667-b352-c75aef9641a4}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Crear tablas"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{43E8FA75-9B2D-4C20-83CA-7008822B6AE8}"
              SQLTask:BypassPrepare="False"
              SQLTask:SqlStatementSource="/* TABLA CUSTOMERS */&#xA;IF NOT EXISTS (SELECT * FROM sys.objects WHERE object_id = OBJECT_ID(N'[dbo].[INT_CUSTOMERS_TOTAL]') AND type in (N'U'))&#xA;BEGIN&#xA;    CREATE TABLE [dbo].[INT_CUSTOMERS_TOTAL](&#xA;        [CUSTOMER_ID] [int] NOT NULL, -- PK de negocio&#xA;        [FULL_NAME] [nvarchar](255) NULL,&#xA;        [BIRTH_DATE] [datetime] NULL,&#xA;        [CUSTOMER_AGE] [int] NULL,&#xA;        [CITY] [nvarchar](255) NULL,&#xA;        [STATE] [nvarchar](255) NULL,&#xA;        [ZIPCODE] [nvarchar](255) NULL,&#xA;        [CUSTOMER_TYPE] [nvarchar](9) NULL,&#xA;        CONSTRAINT [PK_CUSTOMER] PRIMARY KEY CLUSTERED ([CUSTOMER_ID] ASC)&#xA;    )&#xA;END;&#xA;&#xA;/* TABLA EMPLOYEES */&#xA;IF NOT EXISTS (SELECT * FROM sys.objects WHERE object_id = OBJECT_ID(N'[dbo].[INT_EMPLOYEES]') AND type in (N'U'))&#xA;BEGIN&#xA;    CREATE TABLE [dbo].[INT_EMPLOYEES](&#xA;        [EMPLOYEE_ID] [int] NOT NULL, -- PK de negocio&#xA;        [FULL_NAME] [nvarchar](255) NULL,&#xA;        [CATEGORY] [nvarchar](255) NULL,&#xA;        [GENDER] [nvarchar](255) NULL,&#xA;        [EMPLOYMENT_DATE] [datetime] NULL,&#xA;        [BIRTH_DATE] [datetime] NULL,&#xA;        CONSTRAINT [PK_EMPLOYEE] PRIMARY KEY CLUSTERED ([EMPLOYEE_ID] ASC)&#xA;    )&#xA;END;&#xA;&#xA;IF NOT EXISTS (SELECT * FROM sys.objects WHERE object_id = OBJECT_ID(N'[dbo].[INT_PRODUCTS]') AND type in (N'U'))&#xA;BEGIN&#xA;    CREATE TABLE [dbo].[INT_PRODUCTS](&#xA;        [PRODUCT_ID] [int] NOT NULL, -- PK de negocio&#xA;        [PRODUCT_NAME] [nvarchar](255) NULL,&#xA;        [LITERS] [decimal](18, 2) NULL, &#xA;        [PACKAGING_TYPE] [nvarchar](50) NULL, &#xA;        [IS_CAN] [int] NULL,&#xA;        CONSTRAINT [PK_PRODUCT] PRIMARY KEY CLUSTERED ([PRODUCT_ID] ASC)&#xA;    )&#xA;END;&#xA;&#xA;IF NOT EXISTS (SELECT * FROM sys.objects WHERE object_id = OBJECT_ID(N'[dbo].[INT_HOLIDAY]') AND type in (N'U'))&#xA;BEGIN&#xA;    CREATE TABLE [dbo].[INT_HOLIDAY](&#xA;        [HOLIDAY_ID] [int] IDENTITY(1,1) NOT NULL, &#xA;        [DATE] [datetime] NULL,&#xA;        [HOLIDAY_NAME] [nvarchar](255) NULL,&#xA;        CONSTRAINT [PK_HOLIDAY] PRIMARY KEY CLUSTERED ([HOLIDAY_ID] ASC)&#xA;    )&#xA;END;&#xA;&#xA;/* TABLA REGIONS */&#xA;IF NOT EXISTS (SELECT * FROM sys.objects WHERE object_id = OBJECT_ID(N'[dbo].[INT_REGIONS]') AND type in (N'U'))&#xA;BEGIN&#xA;    CREATE TABLE [dbo].[INT_REGIONS](&#xA;        [REGION_ID] [int] IDENTITY(1,1) NOT NULL, -- Se autogenera solo&#xA;        [REGION_NAME] [nvarchar](255) NULL,&#xA;        [AREA] [nvarchar](255) NULL,&#xA;        [CITY] [nvarchar](255) NULL,&#xA;        [ZIPCODE] [nvarchar](255) NULL,&#xA;        CONSTRAINT [PK_REGION] PRIMARY KEY CLUSTERED ([REGION_ID] ASC)&#xA;    )&#xA;END;&#xA;&#xA;/* TABLA AGE RANGE */&#xA;IF NOT EXISTS (SELECT * FROM sys.objects WHERE object_id = OBJECT_ID(N'[dbo].[INT_AGE_RANGE]') AND type in (N'U'))&#xA;BEGIN&#xA;    CREATE TABLE [dbo].[INT_AGE_RANGE](&#xA;        [AgeRangeID] [int] IDENTITY(1,1) NOT NULL, -- PK&#xA;        [AGE_RANGE_NAME] [nvarchar](50) NULL,&#xA;        [MinAge] [int] NULL,  -- Antes era MIN_AGE&#xA;        [MaxAge] [int] NULL,  -- Antes era MAX_AGE&#xA;        CONSTRAINT [PK_AGE_RANGE] PRIMARY KEY CLUSTERED ([AgeRangeID] ASC)&#xA;    )&#xA;END;&#xA;&#xA;/* TABLA FACT SALES */&#xA;IF NOT EXISTS (SELECT * FROM sys.objects WHERE object_id = OBJECT_ID(N'[dbo].[INT_FACT_SALES]') AND type in (N'U'))&#xA;BEGIN&#xA;    CREATE TABLE [dbo].[INT_FACT_SALES](&#xA;        [Fact_SalesKey] [int] IDENTITY(1,1) NOT NULL, &#xA;        [BillingID] [int] NOT NULL,&#xA;        [CustomerID] [int] NULL,&#xA;        [EmployeeID] [int] NULL,&#xA;        [ProductID] [int] NULL,&#xA;        [RegionID] [int] NULL,&#xA;        [TimeKey] [int] NULL,&#xA;        [TransactionTimestamp] [datetime] NULL,&#xA;        [Month] [nvarchar](50) NULL,&#xA;        [Year] [int] NULL,&#xA;        [IsHoliday] [nvarchar](3) NULL,&#xA;        [HolidayDescription] [nvarchar](100) NULL,&#xA;        [ValidatedRegion] [nvarchar](100) NULL,&#xA;        [CustomerZipCode] [nvarchar](255) NULL,&#xA;        [AgeRangeID] [int] NULL, -- Esta columna recibirá el ID de la tabla anterior&#xA;        [PackagingType] [nvarchar](50) NULL,&#xA;        [Quantity] [decimal](18, 1) NULL,&#xA;        [LitersSold] [decimal](18, 1) NULL,&#xA;        [ListUnitPrice] [decimal](18, 2) NULL,&#xA;        [DiscountPercentage] [decimal](18, 2) NULL,&#xA;        [GrossLineTotal] [decimal](18, 2) NULL,&#xA;        [NetLineTotal] [decimal](18, 2) NULL,&#xA;        [GlobalCartTotal] [decimal](18, 2) NULL,&#xA;        CONSTRAINT [PK_INT_FACT_SALES] PRIMARY KEY CLUSTERED ([Fact_SalesKey] ASC)&#xA;    ) ON [PRIMARY];&#xA;END;&#xA;GO" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
        <DTS:Executable
          DTS:refId="Package\Preparar base de datos intermedia\TRUNCATE tablas intermedia"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Tarea Ejecutar SQL"
          DTS:DTSID="{6e7f29b1-db06-44dc-acd7-d8c1eb0290c5}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="TRUNCATE tablas intermedia"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{43E8FA75-9B2D-4C20-83CA-7008822B6AE8}"
              SQLTask:SqlStatementSource="/* LIMPIEZA DE DIMENSIONES Y FACT TABLE CON VERIFICACIÓN */&#xA;&#xA;IF OBJECT_ID('[dbo].[INT_CUSTOMERS_TOTAL]', 'U') IS NOT NULL&#xA;    TRUNCATE TABLE [dbo].[INT_CUSTOMERS_TOTAL];&#xA;&#xA;IF OBJECT_ID('[dbo].[INT_EMPLOYEES]', 'U') IS NOT NULL&#xA;    TRUNCATE TABLE [dbo].[INT_EMPLOYEES];&#xA;&#xA;IF OBJECT_ID('[dbo].[INT_PRODUCTS]', 'U') IS NOT NULL&#xA;    TRUNCATE TABLE [dbo].[INT_PRODUCTS];&#xA;&#xA;IF OBJECT_ID('[dbo].[INT_REGIONS]', 'U') IS NOT NULL&#xA;    TRUNCATE TABLE [dbo].[INT_REGIONS];&#xA;&#xA;IF OBJECT_ID('[dbo].[INT_HOLIDAY]', 'U') IS NOT NULL&#xA;    TRUNCATE TABLE [dbo].[INT_HOLIDAY];&#xA;&#xA;IF OBJECT_ID('[dbo].[INT_AGE_RANGE]', 'U') IS NOT NULL&#xA;    TRUNCATE TABLE [dbo].[INT_AGE_RANGE];&#xA;&#xA;IF OBJECT_ID('[dbo].[INT_FACT_SALES]', 'U') IS NOT NULL&#xA;    TRUNCATE TABLE [dbo].[INT_FACT_SALES];&#xA;&#xA;/* CARGA AUTOMÁTICA DE LA DIMENSIÓN TIEMPO */&#xA;IF OBJECT_ID('[dbo].[SP_LOAD_INT_TIME]', 'P') IS NOT NULL&#xA;    EXEC [dbo].[SP_LOAD_INT_TIME];" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
          </DTS:ObjectData>
        </DTS:Executable>
      </DTS:Executables>
      <DTS:PrecedenceConstraints>
        <DTS:PrecedenceConstraint
          DTS:refId="Package\Preparar base de datos intermedia.PrecedenceConstraints[Restricción]"
